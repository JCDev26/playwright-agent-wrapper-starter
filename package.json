{
  "name": "playwright-agent-wrapper-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded, reviewable Playwright Test wrapper for external AI-assisted or automated QA callers.",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --project=smoke",
    "test:unit": "playwright test --project=unit",
    "show-report": "playwright show-report artifacts/playwright-report",
    "wrapper:run": "tsx src/playwright-wrapper/execution/runPlaywrightTargetCli.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.10.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
