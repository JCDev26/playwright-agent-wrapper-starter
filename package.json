{
  "name": "playwright-agent-wrapper-starter",
  "version": "0.1.0",
  "private": true,
  "description": "Bounded, reviewable Playwright Test wrapper for external AI-assisted or automated QA callers.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "agent:prepare": "tsx src/playwright-wrapper/performance/prepareMain.ts",
    "agent:performance": "tsx src/playwright-wrapper/performance/cli.ts",
    "test": "node scripts/test.cjs",
    "test:headed": "node scripts/test.cjs --headed",
    "test:smoke": "node scripts/test.cjs --project=smoke",
    "test:unit": "node scripts/test.cjs --project=unit",
    "show-report": "playwright show-report artifacts/playwright-report",
    "wrapper:run": "node scripts/wrapper.cjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.cjs",
    "test:integration": "node scripts/test.cjs --project=integration",
    "demo": "tsx examples/task-board/server.ts",
    "test:mobile": "node scripts/test.cjs --project=mobile-android --project=mobile-ios",
    "test:performance": "node scripts/test.cjs --project=performance",
    "test:load": "tsx examples/load/run.ts",
    "test:ci": "node scripts/test.cjs --project=unit --project=integration --project=smoke --project=mobile-android --project=mobile-ios"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "1.65.1",
    "@types/node": "^22.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.6.3"
  }
}
